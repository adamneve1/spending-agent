# Copy to .env and fill with real values. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Separate multiple IDs with commas.
ALLOWED_TELEGRAM_USER_IDS=
SPREADSHEET_ID=
WORKSHEET_NAME=Spending
# On the Docker host, point this to the service-account JSON file.
GOOGLE_CREDENTIALS_FILE=./credentials.json
# Path inside the app. Relative paths start at the project directory.
GOOGLE_CREDENTIALS_PATH=credentials.json
# Column numbers are 1-based; keep them distinct.
EXPENSE_ID_COLUMN=1
EXPENSE_DATE_COLUMN=3
EXPENSE_DESCRIPTION_COLUMN=4
EXPENSE_CATEGORY_COLUMN=6
EXPENSE_AMOUNT_COLUMN=7
EXPENSE_FIRST_DATA_ROW=2
REPORT_DASHBOARD_RANGE=Report!A1:AZ200
# Range containing the Expenses List / Allocation / Realization table on Report.
# Warning starts when Realization reaches 80% of Allocation.
BUDGET_TABLE_RANGE=Report!B11:G32
# K2 is the selected year; K3 is the selected month name (e.g. September).
BUDGET_PERIOD_RANGE=Report!K2:K3
